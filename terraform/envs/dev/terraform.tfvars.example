# Dev environment tfvars
# Copy to terraform.tfvars and fill in values

# RDS Configuration
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20
rds_password          = "YourSecurePassword123!"

# Container image
container_image = "upload-service:latest"

# AWS Configuration
aws_region            = "us-east-2"
s3_bucket_name        = "upload-service-bucket-ai-analyzer"
aws_account_id        = "YOUR_AWS_ACCOUNT_ID"

# AWS Credentials for pod access to S3 and SQS
# Get these from your AWS IAM user credentials
aws_access_key_id     = "AKIA..."
aws_secret_access_key = "your-secret-access-key..."

# SQS Queues
upload_queue_name       = "upload-queue"
status_update_queue_name = "status-update-queue"

# Application Configuration
spring_profile          = "dev"
hibernate_ddl_auto      = "update"
flyway_enabled          = "false"
sqs_result_listener_enabled = "true"
sqs_result_listener_poll_interval_seconds = 5
sqs_result_listener_max_messages = 10
sqs_result_listener_wait_time_seconds = 5
